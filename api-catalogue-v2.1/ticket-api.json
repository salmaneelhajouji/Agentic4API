{
  "openapi": "3.0.0",
  "info": {
    "title": "Ticket API",
    "version": "1.0.0",
    "x-api-id": "ticket-api",
    "x-api-version": "v1",
    "x-status": "active",
    "x-team": "Equipe Support",
    "x-domain": "Customer Support",
    "description": "Tickets de support client. Création, assignation, escalade et résolution des incidents et réclamations. DIFFÉRENCE vs task-api : Ticket API traite les demandes entrantes de clients externes nécessitant assistance, alors que task-api gère les tâches internes de planification projet et backlogs des collaborateurs.",
    "x-synonymes": "support, assistance, ticket, incident, réclamation, helpdesk, client, anomalie, bug, escalade, agent, résolution, service client, demande, support technique, litige, mécontentement",
    "x-false-positive-warning": "Pour orchestrer des tâches internes, projets d'équipe ou sprints d'ingénierie sans lien avec le helpdesk client, utilisez task-api.",
    "x-cas-usage": "je veux ouvrir un ticket de support pour un problème client | je veux lister les réclamations d'assistance en priorité critique | je veux assigner un ticket d'incident à un agent | je veux escalader un ticket complexe ou fermer une demande résolue"
  },
  "paths": {
    "/v1/tickets": {
      "post": {
        "summary": "Créer une nouvelle demande de helpdesk ou un ticket de support pour le compte d'un client",
        "operationId": "createTicket",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "subject",
                  "description",
                  "customer_id"
                ],
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "customer_id": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "critical"
                    ],
                    "default": "medium"
                  },
                  "category": {
                    "type": "string",
                    "enum": [
                      "billing",
                      "shipping",
                      "product",
                      "technical",
                      "other"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket créé"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "get": {
        "summary": "Lister, filtrer et trier les tickets de support par statut, niveau de priorité ou agent affecté",
        "operationId": "listTickets",
        "tags": [
          "Tickets"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "pending",
                "resolved",
                "closed"
              ]
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          {
            "name": "assigned_to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tickets/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Consulter les détails complets, l'historique des échanges et le statut d'un ticket spécifique",
        "operationId": "getTicket",
        "tags": [
          "Tickets"
        ],
        "responses": {
          "200": {
            "description": "Ticket"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tickets/{id}/assign": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Attribuer formellement la responsabilité d'un ticket de support à un agent qualifié",
        "operationId": "assignTicket",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent_id"
                ],
                "properties": {
                  "agent_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assigné"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tickets/{id}/escalate": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Escalader un incident complexe vers une équipe technique de niveau supérieur",
        "operationId": "escalateTicket",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "new_priority": {
                    "type": "string",
                    "enum": [
                      "high",
                      "critical"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Escaladé"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tickets/{id}/close": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "put": {
        "summary": "Clôturer définitivement un ticket d'assistance avec saisie de la résolution apportée",
        "operationId": "closeTicket",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "resolution": {
                    "type": "string"
                  },
                  "satisfaction_survey_sent": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Fermé"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tickets/{id}/comments": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Ajouter un message de suivi au ticket (réponse au client ou note masquée interne entre agents)",
        "operationId": "addTicketComment",
        "tags": [
          "Tickets"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string"
                  },
                  "internal": {
                    "type": "boolean",
                    "default": false,
                    "description": "Si true, visible agents seulement"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Commentaire ajouté"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {}
}