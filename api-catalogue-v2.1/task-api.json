{
  "openapi": "3.0.0",
  "info": {
    "title": "Task API",
    "version": "1.0.0",
    "x-api-id": "task-api",
    "x-api-version": "v1",
    "x-status": "active",
    "x-team": "Equipe Platform",
    "x-domain": "Operations",
    "description": "Gestion des tâches et listes de tâches (todo). Assignation, priorités, liens de dépendances et suivi d'avancement des plans de travail internes. DIFFÉRENCE vs ticket-api : Task = tâche de travail interne planifiée (projet, sprint, backlog), Ticket = demande entrante d'un client nécessitant une résolution (support). DIFFÉRENCE vs workflow-api : Task = unité de travail humain simple, Workflow = orchestration automatisée de processus multi-étapes.",
    "x-synonymes": "tâche, todo, projet, assignation, priorité, échéance, sprint, backlog, avancement, collaboration, ticket interne, planning, checklist, dépendance, productivité, de-faire, suivi de projet",
    "x-false-positive-warning": "Pour piloter des réclamations clients ou demandes d'assistance au support, utilisez ticket-api. Pour automatiser des enchaînements applicatifs ou des batchs, préférez workflow-api.",
    "x-cas-usage": "je veux créer une nouvelle tâche d'ingénierie dans notre backlog | je veux lister toutes les actions en cours d'un collaborateur | je veux modifier le statut d'une tâche pour la passer en revue | je veux lier deux tâches par un lien d'antériorité bloquant"
  },
  "paths": {
    "/v1/tasks": {
      "post": {
        "summary": "Créer une nouvelle tâche opérationnelle dans un projet avec assignation et estimation horaire",
        "operationId": "createTask",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tâche créée"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "get": {
        "summary": "Lister, trier et filtrer les tâches du plan de travail selon le responsable, le projet ou l'échéance",
        "operationId": "listTasks",
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "name": "assignee_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "review",
                "done",
                "cancelled"
              ]
            }
          },
          {
            "name": "priority",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            }
          },
          {
            "name": "project_id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "due_before",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tâches"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tasks/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^TASK-[0-9]{4}$"
          }
        }
      ],
      "get": {
        "summary": "Consulter les métadonnées complètes, la description détaillée et l'historique d'une tâche de travail",
        "operationId": "getTask",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "200": {
            "description": "Tâche"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "put": {
        "summary": "Mettre à jour globalement les propriétés, la priorité ou le périmètre d'une tâche existante",
        "operationId": "updateTask",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mis à jour"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Supprimer définitivement une tâche du backlog ou du tableau d'activités",
        "operationId": "deleteTask",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "204": {
            "description": "Supprimée"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tasks/{id}/status": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "summary": "Changer rapidement l'état d'avancement d'une tâche au sein du workflow opérationnel",
        "operationId": "updateTaskStatus",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "todo",
                      "in_progress",
                      "review",
                      "done",
                      "cancelled"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Statut mis à jour"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tasks/{id}/dependencies": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Consulter les liaisons de dépendances (tâches bloquantes ou bloquées) rattachées à l'élément",
        "operationId": "getTaskDeps",
        "tags": [
          "Tasks"
        ],
        "responses": {
          "200": {
            "description": "Dépendances"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      },
      "post": {
        "summary": "Établir un lien de dépendance strict (blocks, blocked_by, relates_to) entre deux tâches du planning",
        "operationId": "addTaskDep",
        "tags": [
          "Tasks"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "type"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "blocks",
                      "blocked_by",
                      "relates_to"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Dépendance ajoutée"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/v1/tasks/my": {
      "get": {
        "summary": "Récupérer la liste des tâches affectées exclusivement à l'utilisateur connecté authentifié",
        "operationId": "getMyTasks",
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "due_today",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Mes tâches"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TaskCreate": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "assignee_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "default": "medium"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_hours": {
            "type": "number"
          }
        }
      }
    }
  }
}