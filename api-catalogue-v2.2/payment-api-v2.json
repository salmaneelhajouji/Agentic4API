        "tags": ["Payments"],
        "responses": {"200": {"description": "Capturé"}}
      }
    },
    "/v2/payments/{id}/refund": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "post": {
        "summary": "DEPRECATED — Remboursement total ou partiel",
