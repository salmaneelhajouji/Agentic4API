  "paths": {
    "/v2/payments": {
      "post": {
        "summary": "DEPRECATED — Initier un paiement carte/PayPal/SEPA",
        "operationId": "createPaymentV2",
        "tags": ["Payments"],
        "responses": {"201": {"description": "Paiement initié"}}
      },
      "get": {
        "summary": "DEPRECATED — Lister les paiements",
        "operationId": "listPaymentsV2",
        "tags": ["Payments"],
        "responses": {"200": {"description": "Paiements"}}
      }
    },
    "/v2/payments/{id}": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "get": {
        "summary": "DEPRECATED — Statut d un paiement PAY-XXXX",
        "operationId": "getPaymentV2",
        "tags": ["Payments"],
        "responses": {"200": {"description": "Paiement"}}
      }
    },
    "/v2/payments/{id}/capture": {
      "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string"}}],
      "post": {
        "summary": "DEPRECATED — Capturer un paiement pré-autorisé",
